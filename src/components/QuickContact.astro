---
// WhatsApp (hazır mesajlı) ve telefonla arama bağlantıları.
// variant="menu": hero'daki açılır seçim listesi; variant="buttons": yan yana butonlar.
const { contact, labels, variant = 'buttons' } = Astro.props;
const waHref = `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(contact.whatsappMessage)}`;
const telHref = `tel:${contact.phoneHref}`;
---

<div class:list={['qc', `qc-${variant}`]}>
  <a href={waHref} target="_blank" rel="noopener" class="qc-item qc-wa">
    <span class="qc-ico" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.2h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.23 8.23 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/></svg>
    </span>
    <span class="qc-txt">
      <span class="qc-label">{labels.whatsapp}</span>
      {labels.whatsappHint && <span class="qc-hint">{labels.whatsappHint}</span>}
    </span>
  </a>
  <a href={telHref} class="qc-item qc-tel">
    <span class="qc-ico" aria-hidden="true">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 1.6 4.2 2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L7.6 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
    </span>
    <span class="qc-txt">
      <span class="qc-label">{labels.call}</span>
      <span class="qc-hint">{contact.phoneDisplay}</span>
    </span>
  </a>
</div>

<style>
  .qc { display: flex; gap: 10px; }
  .qc-item {
    display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--ink);
    transition: background .2s ease, transform .2s var(--ease), border-color .2s ease;
  }
  .qc-ico {
    flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; border-radius: 50%;
  }
  .qc-wa .qc-ico { background: rgba(37,211,102,0.14); color: #1E9E57; }
  .qc-tel .qc-ico { background: rgba(126,154,134,0.18); color: var(--sage-deep); }
  .qc-txt { display: flex; flex-direction: column; line-height: 1.3; }
  .qc-label { font-size: 15px; font-weight: 700; }
  .qc-hint { font-size: 12.5px; color: var(--ink-soft); margin-top: 2px; }

  /* Hero açılır menüsü */
  .qc-menu { flex-direction: column; gap: 4px; }
  .qc-menu .qc-item { padding: 10px 12px; border-radius: 14px; }
  .qc-menu .qc-item:hover, .qc-menu .qc-item:focus-visible { background: rgba(126,154,134,0.12); }

  /* Booking bölümündeki butonlar */
  .qc-buttons { flex-wrap: wrap; margin-top: 28px; }
  .qc-buttons .qc-item {
    flex: 1 1 200px; padding: 11px 18px 11px 12px; border-radius: 999px;
    background: var(--paper-hi); border: 1px solid var(--line);
    box-shadow: 0 10px 26px rgba(38,48,42,0.07);
  }
  .qc-buttons .qc-item:hover { transform: translateY(-2px); border-color: rgba(126,154,134,0.5); }
</style>
